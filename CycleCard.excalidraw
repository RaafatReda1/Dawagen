    {
      "id": "jwpKFyLTtpMjEYzrGS5Mv",
      "type": "text",
      "x": 706.2268693411934,
      "y": 2318.4694582855154,
      "width": 1807.734619140625,
      "height": 450,
      "angle": 0,
      "strokeColor": "#1e1e1e",
